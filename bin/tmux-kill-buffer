#!/usr/bin/env sh
# 現在のペインをbgウィンドウへ移動
# run-shellから呼ばれる: $1=pane_id, $2=session（フォーマット展開済み）, $3=--no-fill（任意）
# --no-fill: bgの最新ペインで埋めずにそのまま枠を閉じる

current_pane_id="${1:-$(tmux display-message -p '#{pane_id}')}"
current_session="${2:-$(tmux display-message -p '#{session_name}')}"
no_fill=0
kill_mode=0
[ "$3" = "--no-fill" ] && no_fill=1
[ "$3" = "--kill"    ] && kill_mode=1

# bgウィンドウが存在しなければ作成（このとき初期シェルが1つ自動生成される）
fresh_bg=0
if ! tmux list-windows -t "$current_session" -F "#{window_name}" 2>/dev/null | grep -qx "bg"; then
  tmux new-window -d -n bg -t "$current_session"
  tmux set-window-option -t "${current_session}:bg" automatic-rename off
  tmux set-window-option -t "${current_session}:bg" pane-border-status off
  fresh_bg=1
fi

# 現在のウィンドウ情報を取得
current_window=$(tmux display-message -p -t "$current_pane_id" '#{window_id}')
pane_count=$(tmux list-panes -t "$current_window" 2>/dev/null | wc -l | tr -d ' ')

# bgウィンドウのpane-border-statusを無効化（最低高さを1行にするため）
tmux set-window-option -t "${current_session}:bg" pane-border-status off

bg_pane_count=$(tmux list-panes -t "${current_session}:bg" 2>/dev/null | wc -l | tr -d ' ')

# swap-paneはfzf-bufferと同様クロスウィンドウで動作し、サイズ・位置がそのまま保たれる
if [ "$kill_mode" -eq 1 ]; then
  # --kill: bgの最新ペインで埋めて、元のペイン（bgに移動済み）をkill
  if [ "$fresh_bg" -eq 0 ] && [ "$bg_pane_count" -ge 1 ]; then
    latest_bg_pane=$(tmux list-panes -t "${current_session}:bg" -F '#{pane_id}' | tail -1)
    tmux swap-pane -d -s "$latest_bg_pane" -t "$current_pane_id"
    tmux kill-pane -t "$current_pane_id"
  else
    tmux kill-pane -t "$current_pane_id"
  fi
elif [ "$no_fill" -eq 0 ] && [ "$fresh_bg" -eq 0 ] && [ "$bg_pane_count" -ge 1 ]; then
  # bgに最後に追加されたペイン（list-panesの最後 = 最大インデックス）
  latest_bg_pane=$(tmux list-panes -t "${current_session}:bg" -F '#{pane_id}' | tail -1)

  # ZがXの位置に入り、XがbgのZの位置に移動（1コマンドで完結）
  tmux swap-pane -d -s "$latest_bg_pane" -t "$current_pane_id"
else
  # no-fill / bgが空 / 初回作成直後：枠を閉じてbg送り
  # --no-fill かつ1ペインのみ: ウィンドウごと閉じる（split不要）
  # それ以外で1ペインのみ: 先に新しいシェルを用意して外枠を維持
  if [ "$pane_count" -le 1 ] && [ "$no_fill" -eq 0 ]; then
    tmux split-window -d -t "$current_pane_id"
  fi
  tmux join-pane -dh -s "$current_pane_id" -t "${current_session}:bg"
fi

# bg内の全ペインを1行に縮めてスペースを確保
tmux list-panes -t "${current_session}:bg" -F '#{pane_id}' | \
  xargs -I{} tmux resize-pane -t {} -y 1

"$HOME/dotfiles/bin/tmux-ensure-bg-last" "$current_session"
