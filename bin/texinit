#!/bin/bash

set -euo pipefail

usage() {
  cat <<'EOT'
Usage:
  texinit [name]
  texinit --mylab [name]
  texinit --watch [name]
  texinit --mylab --watch [name]

Examples:
  texinit
  texinit report
  texinit --mylab
  texinit --mylab report
EOT
}

mode="build"
template="basic"
name="main"

resolve_script_dir() {
  local source_path="${BASH_SOURCE[0]}"
  local source_dir resolved

  while [ -L "$source_path" ]; do
    source_dir="$(CDPATH= cd -- "$(dirname -- "$source_path")" && pwd)"
    resolved="$(readlink "$source_path")"
    if [[ "$resolved" != /* ]]; then
      source_path="${source_dir}/${resolved}"
    else
      source_path="$resolved"
    fi
  done

  CDPATH= cd -- "$(dirname -- "$source_path")" && pwd
}

resolve_repo_root() {
  if [ -n "${DOTFILES_DIR:-}" ] && [ -d "${DOTFILES_DIR}/templates/texinit" ]; then
    printf '%s\n' "$DOTFILES_DIR"
    return 0
  fi

  local resolved_script_dir
  resolved_script_dir="$(resolve_script_dir)"
  CDPATH= cd -- "${resolved_script_dir}/.." && pwd
}

require_template_file() {
  local src="$1"

  if [ ! -f "$src" ]; then
    echo "Error: template file not found: $src" >&2
    exit 1
  fi
}

repo_root="$(resolve_repo_root)"
template_root="${repo_root}/templates/texinit"

while [ $# -gt 0 ]; do
  case "$1" in
    --mylab)
      template="mylab"
      shift
      ;;
    --watch)
      mode="watch"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -* )
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    * )
      name="$1"
      shift
      ;;
  esac
done

tex_file="${name}.tex"

case "$template" in
  basic|mylab)
    template_dir="${template_root}/${template}"
    ;;
  *)
    echo "Error: unknown template: ${template}" >&2
    exit 1
    ;;
esac

if [ ! -d "$template_dir" ]; then
  echo "Error: template directory not found: $template_dir" >&2
  echo "Set DOTFILES_DIR to your dotfiles checkout, or run texinit from the tracked repo path." >&2
  exit 1
fi

template_files=(Makefile .gitignore .latexmkrc main.tex)
if [ "$template" = "mylab" ]; then
  template_files+=(mylab-techrep.sty)
fi

for file in "${template_files[@]}"; do
  require_template_file "${template_dir}/${file}"
done

targets=("$tex_file" .latexmkrc Makefile .gitignore)
if [ "$template" = "mylab" ]; then
  targets+=(mylab-techrep.sty fig)
fi

for file in "${targets[@]}"; do
  if [ -e "$file" ]; then
    echo "Error: $file already exists in $(pwd)." >&2
    echo "Run this in a new directory, or move/remove the existing files first." >&2
    exit 1
  fi
done

escape_sed_replacement() {
  printf '%s' "$1" | sed 's/[&/]/\\&/g'
}

render_template() {
  local src="$1"
  local dst="$2"
  local escaped_name
  escaped_name="$(escape_sed_replacement "$name")"
  sed "s/__TEX_BASENAME__/${escaped_name}/g" "$src" > "$dst"
}

render_template "${template_dir}/Makefile" Makefile
render_template "${template_dir}/.gitignore" .gitignore
render_template "${template_dir}/.latexmkrc" .latexmkrc
render_template "${template_dir}/main.tex" "$tex_file"

if [ "$template" = "mylab" ]; then
  cp "${template_dir}/mylab-techrep.sty" ./mylab-techrep.sty
  mkdir -p fig
fi

echo "Created: ${tex_file}, .latexmkrc, Makefile, .gitignore"
if [ "$template" = "mylab" ]; then
  echo "Created: mylab-techrep.sty, fig/"
fi

case "$mode" in
  build)
    exec make
    ;;
  watch)
    exec make watch
    ;;
esac
