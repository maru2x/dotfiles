#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
. "$script_dir/clipboard-backend.sh"

paste_status=0
if clipboard_try_paste; then
  exit 0
else
  paste_status=$?
fi

if [ "$paste_status" -eq 2 ]; then
  echo "Invalid DOTFILES_CLIPBOARD_BACKEND: ${DOTFILES_CLIPBOARD_BACKEND:-}" >&2
else
  echo "No clipboard backend succeeded" >&2
fi
exit 1
