#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
. "$script_dir/clipboard-backend.sh"

tmp="${TMPDIR:-/tmp}/clipboard-copy.$$"
trap 'rm -f "$tmp"' EXIT HUP INT TERM
cat >"$tmp"

copy_status=0
if clipboard_try_copy_from_file "$tmp"; then
  clipboard_history_append "$tmp"
  exit 0
else
  copy_status=$?
fi

if [ "$copy_status" -eq 2 ]; then
  echo "Invalid DOTFILES_CLIPBOARD_BACKEND: ${DOTFILES_CLIPBOARD_BACKEND:-}" >&2
else
  echo "No clipboard backend succeeded" >&2
  echo "-> run: clipboard-doctor" >&2
fi
exit 1
