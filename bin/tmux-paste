#!/usr/bin/env sh
set -eu

tmp="${TMPDIR:-/tmp}/tmux-paste.$$"
trap 'rm -f "$tmp"' EXIT HUP INT TERM

# clipboard-paste が成功した場合だけ tmux バッファを更新する
# 失敗した場合は直前の tmux バッファ（copy-pipe-and-cancel が書いたもの）をそのまま使う
if "$HOME/dotfiles/bin/clipboard-paste" >"$tmp" 2>/dev/null && [ -s "$tmp" ]; then
  tmux load-buffer "$tmp"
fi
tmux paste-buffer -p
